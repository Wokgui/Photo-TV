<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#0F8CFF" android:endColor="#1263FF"/>
            <corners android:radius="14dp"/>
            <stroke android:width="2dp" android:color="#B9D7FF"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#0D83FF" android:endColor="#075DFF"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#4FA4FF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#111B28" android:endColor="#09131E"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#26364A"/>
        </shape>
    </item>
</selector>