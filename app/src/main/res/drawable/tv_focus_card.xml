<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#16283B" android:endColor="#0B1723"/>
            <corners android:radius="16dp"/>
            <stroke android:width="3dp" android:color="#32A0FF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#111C29" android:endColor="#08121B"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#253449"/>
        </shape>
    </item>
</selector>